	lineageTag: 1b0f3c52-7a11-4d2e-9c84-5e6a2f0d9a01

	annotation PBI_ResultType = Text

expression src_MatDoc =
		let
		    Source = Csv.Document(File.Contents(DataFolder & "matdoc.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Typed = Table.TransformColumnTypes(Promoted, {{"movement_type", type text}, {"reference", type text}, {"matdoc_no", type text}, {"sku", type text}, {"batch", type text}, {"plant", type text}, {"product_division", type text}, {"posting_date", type date}, {"quantity", type number}})
		in
		    Typed
