		summarizeBy: none
		sourceColumn: Receipt History

		annotation SummarizationSetBy = Automatic

	column 'Receipt Qty'
		dataType: double
		isHidden
		lineageTag: 3ed77e71-601b-4a36-b9f6-13247ce77b0b
		summarizeBy: none
		sourceColumn: Receipt Qty

		annotation SummarizationSetBy = Automatic

	column 'Expiry Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 5d0b7a52-3f1c-4c1e-9a6e-2f4b8e7c1a93
		summarizeBy: none
		sourceColumn: Expiry Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Days To Expiry' = IF(ISBLANK(PendingReceipt[Expiry Date]), BLANK(), DATEDIFF(TODAY(), PendingReceipt[Expiry Date], DAY))
		dataType: int64
		formatString: 0
		lineageTag: b1e84c6d-7a29-4f0e-8d35-6c9a2e5f7b10
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Region =
			VAR idx = PendingReceipt[Owner Record Idx]
			VAR nm0 = IF(ISBLANK(idx), BLANK(), TRIM(LOOKUPVALUE(OwnerAlignment[region_name], OwnerAlignment[src_idx], idx)))
			VAR nm = IF(RIGHT(nm0, 1) = ")" && SEARCH(" (", nm0, 1, 0) > 0, TRIM(LEFT(nm0, SEARCH(" (", nm0) - 1)), nm0)
			VAR rid = TRIM(PendingReceipt[Region ID])
			RETURN COALESCE(IF(nm = "", BLANK(), nm), IF(rid = "", BLANK(), rid), "Unassigned")
		dataType: string
		lineageTag: 8fcc2e4a-88fb-42b5-ab18-1a2e3029b605
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition PendingReceipt = m
		mode: import
		source =
				let
				    FieldPlants = {"FLD2", "FLD1", "FLD3"},
				    T = (v as any) as text => if v = null then "" else Text.From(v),
				    Norm = (v as any) as text => Text.Upper(Text.Trim(T(v))),
				    NormMat = (v as any) as text => Text.TrimStart(Norm(v), "0"),
				    InScope = (p as text) as logical => Text.StartsWith(p, "DC") or List.Contains(FieldPlants, p),
				    IsMC = (p as text) as logical => Text.StartsWith(p, "DC"),
				    CleanNum = (v as any) as nullable text =>
				        let t = Text.Trim(T(v))
				        in if t = "" then null
				           else if Text.Select(t, {"0".."9"}) = t then (if Text.TrimStart(t, "0") = "" then "0" else Text.TrimStart(t, "0"))
				           else t,
				    Raw = (v as any) as nullable text => let t = Text.Trim(T(v)) in if t = "" then null else t,
				    LoadedAt = DateTime.LocalNow(),
				
				    Docs0 = Table.SelectRows(src_MatDoc, each List.Contains({"ISS", "RCP"}, Norm([movement_type])) and InScope(Norm([plant]))),
				    Docs1 = Table.AddColumn(Docs0, "Mov_n", each Norm([movement_type]), type text),
				    Docs2 = Table.AddColumn(Docs1, "Mat_n", each NormMat([sku]), type text),
				    Docs3 = Table.AddColumn(Docs2, "Key", each Norm([plant]) & "|" & NormMat([sku]) & "|" & Norm([batch]), type text),
				    Docs4 = Table.AddColumn(Docs3, "Qty_n", each if [quantity] = null then 0 else [quantity], type number),
				    Docs5 = Table.AddColumn(Docs4, "QIss", each if [Mov_n] = "ISS" then [Qty_n] else 0, type number),
				    Docs = Table.Buffer(Table.AddColumn(Docs5, "QRcp", each if [Mov_n] = "RCP" then [Qty_n] else 0, type number)),
				
				    Sums = Table.Group(Docs, {"Key"}, {{"QtyIss", each List.Sum([QIss]), type number}, {"QtyRcp", each List.Sum([QRcp]), type number}}),
				    LatestIss = Table.Distinct(
				        Table.Buffer(Table.Sort(Table.SelectRows(Docs, each [Mov_n] = "ISS"),
				            {{"posting_date", Order.Descending}, {"reference", Order.Descending}, {"matdoc_no", Order.Descending}})),
				        {"Key"}),
				    DocAgg0 = Table.NestedJoin(Table.SelectColumns(LatestIss, {"Key", "posting_date", "reference", "matdoc_no"}), {"Key"}, Sums, {"Key"}, "S", JoinKind.Inner),
				    DocAgg = Table.Buffer(Table.AddColumn(Table.ExpandTableColumn(DocAgg0, "S", {"QtyIss", "QtyRcp"}), "HasDoc", each true, type logical)),
				
				    MatBU = Table.Buffer(Table.Distinct(
				        Table.SelectColumns(Table.AddColumn(Docs, "BU", each if Norm([product_division]) = "10" then "DIV-B" else "DIV-A", type text), {"Mat_n", "BU"}),
				        {"Mat_n"})),
				
				    Ret0 = Table.AddColumn(src_Return, "RK", each Norm([plant]) & "|" & NormMat([sku]) & "|" & Norm([batch]), type text),
				    RetByKey = Table.Group(Ret0, {"RK"}, {{"RetUnits", each List.Sum([quantity]) / 2, type number}}),
				
					    N = (x as nullable number) as number => if x = null then 0 else x,
					    Hist0 = Table.AddColumn(src_FieldHistory, "HK", each Norm([plant]) & "|" & NormMat([sku]) & "|" & Norm([batch]), type text),
					    Hist1 = Table.AddColumn(Table.AddColumn(Hist0, "OA", each N([a]) - N([c]), type number), "OD", each N([d]) - N([b]), type number),
					    HistByKey = Table.Buffer(Table.Group(Hist1, {"HK"}, {{"HOpenA", each List.Sum([OA]), type number}, {"HOpenD", each List.Sum([OD]), type number}})),
				
				    Trk0 = Table.SelectRows(Table.AddColumn(src_Tracking, "Del", each CleanNum([delivery_no]), type nullable text), each [Del] <> null),
				    Trk1 = Table.AddColumn(Trk0, "Tok", each List.Select(List.Transform(Text.Split(T([tracking]), ","), each Text.Trim(_)), each _ <> ""), type list),
				    TrkByDel = Table.Buffer(Table.Group(Trk1, {"Del"}, {
				        {"DC Tracking", each let s = Text.Combine(List.Distinct(List.Combine([Tok])), ", ") in if s = "" then null else s, type nullable text},
				        {"DC Carrier", each List.First(List.Select(List.Distinct([carrier]), each _ <> null and Text.Trim(_) <> ""), null), type nullable text}})),
				
				    Scan0 = Table.SelectRows(Docs, each [Mov_n] = "RCP"),
				    Scan1 = Table.SelectRows(Table.AddColumn(Scan0, "Del", each CleanNum([reference]), type nullable text), each [Del] <> null and [posting_date] <> null),
				    ScanByDel = Table.Buffer(Table.Group(Scan1, {"Del"}, {{"Last Scan Date", each List.Max([posting_date]), type nullable date}})),
				
				    Ev0 = Table.SelectRows(Docs, each [Mov_n] = "RCP" and [posting_date] <> null),
				    EvG = Table.Group(Ev0, {"Key"}, {
				        {"Receipt Events", each Table.RowCount(_), Int64.Type},
				        {"First Receipt Date", each List.Min([posting_date]), type nullable date},
				        {"Receipt History", each Text.Combine(List.Transform(List.FirstN(Table.ToRecords(Table.Sort(_, {{"posting_date", Order.Descending}, {"reference", Order.Descending}})), 10), each Date.ToText(_[posting_date], "yyyy-MM-dd") & " " & (Raw(_[reference]) ?? "n/a") & " x" & Text.From(_[Qty_n])), "; "), type text},
				        {"Receipt Qty", each List.Sum([Qty_n]), type number}}),
				    Ev = Table.Buffer(EvG),
				
				    FI0 = Table.SelectRows(src_FieldInventory, each [qty_in_transit] <> null and [qty_in_transit] > 0 and InScope(Norm([branch]))),
				    FI1 = Table.AddColumn(FI0, "Plant_n", each Norm([branch]), type text),
				    FI2 = Table.AddColumn(FI1, "Mat_n", each NormMat([sku]), type text),
				    FI3 = Table.AddColumn(FI2, "KeyLot", each let b = Norm([batch]) in if b = "" then null else [Plant_n] & "|" & [Mat_n] & "|" & b, type nullable text),
				    FI4 = Table.AddColumn(FI3, "KeyVen", each let b = Norm([vendor_batch]) in if b = "" then null else [Plant_n] & "|" & [Mat_n] & "|" & b, type nullable text),
				    FI5 = Table.ExpandTableColumn(Table.NestedJoin(FI4, {"Mat_n"}, MatBU, {"Mat_n"}, "B", JoinKind.Inner), "B", {"BU"}, {"BU_div"}),
				    FI6 = Table.AddColumn(FI5, "BU", each let p = [Plant_n] in if p = "FLD3" then "DIV-B" else if p = "FLD1" or p = "FLD2" then "DIV-A" else [BU_div], type text),
				    FI7 = Table.AddColumn(FI6, "Region ID", each Text.Trim(T(if [BU] = "DIV-B" then [region_b] else [region_a])), type text),
				    FI8 = Table.AddColumn(FI7, "Territory ID", each Text.Trim(T(if [BU] = "DIV-B" then [territory_b] else [territory])), type text),
				
				    J1 = Table.ExpandTableColumn(Table.NestedJoin(FI8, {"KeyLot"}, DocAgg, {"Key"}, "L", JoinKind.LeftOuter),
				        "L", {"posting_date", "reference", "matdoc_no", "QtyIss", "QtyRcp", "HasDoc"}, {"L_date", "L_ref", "L_md", "L_a", "L_c", "L_has"}),
				    J2 = Table.ExpandTableColumn(Table.NestedJoin(J1, {"KeyVen"}, DocAgg, {"Key"}, "V", JoinKind.LeftOuter),
				        "V", {"posting_date", "reference", "matdoc_no", "QtyIss", "QtyRcp", "HasDoc"}, {"V_date", "V_ref", "V_md", "V_a", "V_c", "V_has"}),
				
				    Hit = Table.AddColumn(J2, "Matched On", each if [L_has] = true then "Lot Batch" else if [V_has] = true then "Vendor Batch" else null, type nullable text),
				    PDate = Table.AddColumn(Hit, "Issue Posting Date", each if [Matched On] = "Lot Batch" then [L_date] else if [Matched On] = "Vendor Batch" then [V_date] else null, type nullable date),
				    PRef = Table.AddColumn(PDate, "Ref_x", each if [Matched On] = "Lot Batch" then [L_ref] else if [Matched On] = "Vendor Batch" then [V_ref] else null, type nullable text),
				    PMd = Table.AddColumn(PRef, "Md_x", each if [Matched On] = "Lot Batch" then [L_md] else if [Matched On] = "Vendor Batch" then [V_md] else null, type nullable text),
				    PA = Table.AddColumn(PMd, "Qty Issued", each if [Matched On] = "Lot Batch" then [L_a] else if [Matched On] = "Vendor Batch" then [V_a] else null, type nullable number),
				    PC = Table.AddColumn(PA, "Qty Received", each if [Matched On] = "Lot Batch" then [L_c] else if [Matched On] = "Vendor Batch" then [V_c] else null, type nullable number),
				    POut = Table.AddColumn(PC, "Outstanding Qty", each if [Qty Issued] = null then null else [Qty Issued] - [Qty Received], type nullable number),
				    PKey = Table.AddColumn(POut, "MKey", each if [Matched On] = "Lot Batch" then [KeyLot] else if [Matched On] = "Vendor Batch" then [KeyVen] else if [KeyLot] <> null then [KeyLot] else if [KeyVen] <> null then [KeyVen] else [Plant_n] & "|" & [Mat_n] & "|", type text),
				    TIn = Table.Group(PKey, {"MKey"}, {{"TUnits", each List.Sum([qty_in_transit]), type number}}),
				    PT = Table.ExpandTableColumn(Table.NestedJoin(PKey, {"MKey"}, TIn, {"MKey"}, "T", JoinKind.LeftOuter), "T", {"TUnits"}, {"Key In-Transit Units"}),
				    PR0 = Table.ExpandTableColumn(Table.NestedJoin(PT, {"MKey"}, RetByKey, {"RK"}, "R", JoinKind.LeftOuter), "R", {"RetUnits"}, {"RetUnits"}),
				    PR = Table.AddColumn(PR0, "Key Return Units", each if [RetUnits] = null then 0 else [RetUnits], type number),
					    PH1 = Table.ExpandTableColumn(Table.NestedJoin(PR, {"KeyLot"}, HistByKey, {"HK"}, "HL", JoinKind.LeftOuter), "HL", {"HOpenA", "HOpenD"}, {"HL_A", "HL_D"}),
					    PH2 = Table.ExpandTableColumn(Table.NestedJoin(PH1, {"KeyVen"}, HistByKey, {"HK"}, "HV", JoinKind.LeftOuter), "HV", {"HOpenA", "HOpenD"}, {"HV_A", "HV_D"}),
					    PHist = Table.AddColumn(Table.AddColumn(PH2, "Hist Open Issue", each if [HL_A] <> null then [HL_A] else [HV_A], type nullable number), "Hist Open Return", each if [HL_D] <> null then [HL_D] else [HV_D], type nullable number),
				    PEvK = Table.AddColumn(PHist, "EvKey", each if Text.EndsWith([MKey], "|") then null else [MKey], type nullable text),
				    PEv = Table.ExpandTableColumn(Table.NestedJoin(PEvK, {"EvKey"}, Ev, {"Key"}, "EvJ", JoinKind.LeftOuter), "EvJ", {"Receipt Events", "First Receipt Date", "Receipt History", "Receipt Qty"}),
				    PStatus = Table.AddColumn(PEv, "Status", each
				        if [Matched On] = null or [Outstanding Qty] <= 0 then
				            (if [Key Return Units] > 0 then "In transit - return (no warehouse receipt yet)"
				             else if [Matched On] = null and IsMC([Plant_n]) then "Overdue pending receipt - issue older than 24 months"
				             else if [Matched On] = null and N([Hist Open Issue]) > 0 then "Overdue pending receipt - issue older than 24 months"
				             else if [Matched On] = null and N([Hist Open Return]) > 0 then "Old return never cleared (no warehouse receipt)"
				             else if [Matched On] = null then "Old stock in transit - no open issue or return in ERP"
				             else "Receipt already posted per extract - verify")
				        else if [Key Return Units] > 0 then "Pending receipt - possible (return in same batch)"
				        else "Pending receipt", type text),
				    PSort = Table.AddColumn(PStatus, "Status Sort", each
				        if [Status] = "Pending receipt" then 1
				        else if [Status] = "Pending receipt - possible (return in same batch)" then 2
				        else if [Status] = "In transit - return (no warehouse receipt yet)" then 3
				        else if [Status] = "Receipt already posted per extract - verify" then 4
					        else if [Status] = "Overdue pending receipt - issue older than 24 months" then 5
					        else if [Status] = "Old return never cleared (no warehouse receipt)" then 6
					        else if [Status] = "Old stock in transit - no open issue or return in ERP" then 7
				        else 99, Int64.Type),
				    PDeliv = Table.AddColumn(PSort, "Delivery Key", each if [Matched On] <> null and IsMC([Plant_n]) then CleanNum([Ref_x]) else null, type nullable text),
				    PMatDoc = Table.AddColumn(PDeliv, "Material Document Key", each if [Matched On] <> null and not IsMC([Plant_n]) then CleanNum([Md_x]) else null, type nullable text),
				    PRecDoc = Table.AddColumn(PMatDoc, "Receipt Doc Key", each if [Delivery Key] <> null then [Delivery Key] else [Material Document Key], type nullable text),
				    PTrk = Table.ExpandTableColumn(Table.NestedJoin(PRecDoc, {"Delivery Key"}, TrkByDel, {"Del"}, "TK", JoinKind.LeftOuter), "TK", {"DC Tracking", "DC Carrier"}),
				    PScan = Table.ExpandTableColumn(Table.NestedJoin(PTrk, {"Receipt Doc Key"}, ScanByDel, {"Del"}, "SC", JoinKind.LeftOuter), "SC", {"Last Scan Date"}),
				    PTrkSt = Table.AddColumn(PScan, "Tracking Status", each
				        if [Delivery Key] <> null then (if [DC Tracking] <> null then "Tracking on file" else "No tracking on delivery")
				        else if [Receipt Doc Key] <> null then "n/a - field transfer (no DC tracking)"
				        else "n/a - no issue in last 24 months", type text),
				
				    Cols = Table.AddColumn(Table.AddColumn(Table.AddColumn(Table.AddColumn(Table.AddColumn(Table.AddColumn(Table.AddColumn(PTrkSt,
				        "Plant", each [Plant_n], type text),
				        "Batch", each Raw([batch]), type nullable text),
				        "Serial", each Raw([serial]), type nullable text),
				        "Customer No", each Raw([customer_no]), type nullable text),
				        "Product SKU", each Text.Trim(T([sku])), type text),
				        "Loaded At", each LoadedAt, type datetime),
				        "Sales Territory", each if [Territory ID] = "" then null else [Territory ID], type nullable text),
				    Cols2 = Table.AddColumn(Table.AddColumn(Cols, "Ship To No", each Text.Trim(T([customer_no])), type text), "Sold To No", each Text.Trim(T([sold_to])), type text),
				    Cols3 = Table.AddColumn(Table.AddColumn(Table.AddColumn(Table.AddColumn(Table.AddColumn(Table.AddColumn(Cols2,
				        "Delivery", each if [Delivery Key] <> null then Raw([Ref_x]) else null, type nullable text),
				        "Material Document No", each if [Material Document Key] <> null then Raw([Md_x]) else null, type nullable text),
				        "Receipt Doc", each if [Delivery] <> null then [Delivery] else [Material Document No], type nullable text),
				        "Batch Key", each CleanNum([batch]), type nullable text),
				        "Serial Key", each CleanNum([serial]), type nullable text),
				        "Customer No Key", each CleanNum([customer_no]), type nullable text),
				
				    Selected = Table.SelectColumns(Cols3, {"BU", "Plant", "Receipt Doc", "Delivery", "Material Document No", "Batch", "Serial", "Customer No", "Delivery Key", "Material Document Key", "Receipt Doc Key", "Batch Key", "Serial Key", "Customer No Key", "customer_name",
				        "Sales Territory", "Product SKU", "description", "qty_in_transit", "Issue Posting Date", "Status", "Status Sort", "Qty Issued", "Qty Received", "Outstanding Qty", "Key In-Transit Units", "Key Return Units", "Matched On", "Loaded At", "Region ID", "Territory ID", "Ship To No", "Sold To No", "DC Tracking", "DC Carrier", "Last Scan Date", "Tracking Status", "Receipt Events", "First Receipt Date", "Receipt History", "Receipt Qty", "expiry"}),
				    Renamed = Table.RenameColumns(Selected, {{"customer_name", "Customer Name"}, {"description", "Product Description"}, {"qty_in_transit", "Qty In Transit"}, {"expiry", "Expiry Date"}}),
				    Sorted = Table.Sort(Renamed, {{"BU", Order.Ascending}, {"Plant", Order.Ascending}, {"Status", Order.Ascending}, {"Issue Posting Date", Order.Ascending}}),
				    Typed = Table.TransformColumnTypes(Sorted, {{"Customer Name", type nullable text}, {"Product Description", type nullable text}, {"Qty In Transit", type number}, {"Expiry Date", type nullable date}})
				in
				    Typed

	annotation PBI_ResultType = Table

