/// One row per in-transit unit at an in-scope plant (distribution centres DC* plus field plants FLD1-FLD3), with its latest issue and the issue-minus-receipt netting result. Two business units: DIV-A and DIV-B. All data in this demo is synthetic.
table PendingReceipt
	lineageTag: 90b07f84-997d-4122-a9eb-9c803d67613d

	measure Lines = COUNTROWS(PendingReceipt)
		formatString: #,0
		lineageTag: abf94573-97b7-422a-8ede-08d9875df33c

	measure 'Units In Transit' = SUM(PendingReceipt[Qty In Transit])
		formatString: #,0
		lineageTag: 7b954946-40f4-4f6b-a9ac-fd29cd265b2c

	measure 'Pending Receipt Lines' = CALCULATE([Lines], PendingReceipt[Status] = "Pending receipt")
		formatString: #,0
		lineageTag: c7a27262-5d49-4437-9c66-3b2018af606c

	measure 'Pending Receipt Units' = CALCULATE([Units In Transit], PendingReceipt[Status] = "Pending receipt")
		formatString: #,0
		lineageTag: 4158b8da-5209-45ad-8d1c-300ea699a605

	measure 'Possible Lines' = CALCULATE([Lines], PendingReceipt[Status] = "Pending receipt - possible (return in same batch)")
		formatString: #,0
		lineageTag: 0955d13f-976b-4b5d-a5f9-42abce98b73d

	measure 'Possible Units' = CALCULATE([Units In Transit], PendingReceipt[Status] = "Pending receipt - possible (return in same batch)")
		formatString: #,0
		lineageTag: 84430e89-ac9d-4432-81bd-d36c47cc3b30

	measure 'No Tracking Lines' = CALCULATE([Lines], PendingReceipt[Status] IN {"Pending receipt", "Pending receipt - possible (return in same batch)"}, PendingReceipt[Tracking Status] = "No tracking on delivery")
		formatString: #,0
		lineageTag: 5d8a3c71-2f94-4e06-b1a7-9c0e4d6f8a55

	measure 'Partly Scanned Lines' = CALCULATE([Lines], PendingReceipt[Status] IN {"Pending receipt", "Pending receipt - possible (return in same batch)"}, NOT(ISBLANK(PendingReceipt[Last Scan Date])))
		formatString: #,0
		lineageTag: 9e2b6f40-7c15-4a83-8d39-1a5c0b7e4f66

	measure 'Return In Transit Lines' = CALCULATE([Lines], PendingReceipt[Status] = "In transit - return (no warehouse receipt yet)")
		formatString: #,0
		lineageTag: e1ad4388-095e-41ea-9732-c28108a2b113

	measure 'Return In Transit Units' = CALCULATE([Units In Transit], PendingReceipt[Status] = "In transit - return (no warehouse receipt yet)")
		formatString: #,0
		lineageTag: eaadcde8-b4cb-47c1-961b-79c517e707ee

	measure 'Verify Lines' = CALCULATE([Lines], PendingReceipt[Status] = "Receipt already posted per extract - verify")
		formatString: #,0
		lineageTag: 2b18b467-0765-4be4-bc29-5309d995675b

	measure 'Verify Units' = CALCULATE([Units In Transit], PendingReceipt[Status] = "Receipt already posted per extract - verify")
		formatString: #,0
		lineageTag: b2b10af3-73a5-4a5f-a3c7-98d70e9a6736

	measure 'Overdue Pending Lines' = CALCULATE([Lines], PendingReceipt[Status] = "Overdue pending receipt - issue older than 24 months")
		formatString: #,0
		lineageTag: 1c3455ec-7081-4934-bda3-0917815458aa

	measure 'Overdue Pending Units' = CALCULATE([Units In Transit], PendingReceipt[Status] = "Overdue pending receipt - issue older than 24 months")
		formatString: #,0
		lineageTag: 315b5bc8-c52c-43ad-9bec-a19bb717dbda

	measure 'Pending Share' = DIVIDE([Pending Receipt Lines], [Lines])
		formatString: 0.0%
		lineageTag: 663d44bb-cc5a-4b94-a114-958cee39cb3f

	measure 'Avg Age Days (Pending)' = CALCULATE(AVERAGE(PendingReceipt[Age Days]), PendingReceipt[Status] = "Pending receipt")
		formatString: 0.0
		lineageTag: bcc28383-8682-4495-bf1e-ba793817d697

	measure 'Oldest Pending Days' = CALCULATE(MAX(PendingReceipt[Age Days]), PendingReceipt[Status] = "Pending receipt")
		formatString: #,0
		lineageTag: 2919a5cb-1a2d-4869-8bd5-e8ff399d64f9

	measure 'Customers Pending' = CALCULATE(DISTINCTCOUNT(PendingReceipt[Customer No]), PendingReceipt[Status] = "Pending receipt")
		formatString: #,0
		lineageTag: 910e3cd1-b3e9-4147-8b5e-a806982855a1

	measure 'Open Receipt Docs' = CALCULATE(DISTINCTCOUNT(PendingReceipt[Receipt Doc]), PendingReceipt[Status] = "Pending receipt")
		formatString: #,0
		lineageTag: 0af80c83-a03e-48b5-91a3-d7215ff2930d

	measure 'Last Refreshed' = MAX(PendingReceipt[Loaded At])
		formatString: General Date
		lineageTag: 0654e267-9e6c-4dc7-be5c-3b9543ef118b

	measure 'Old Return Lines' = CALCULATE([Lines], PendingReceipt[Status] = "Old return never cleared (no warehouse receipt)")
		lineageTag: 0c12ca62-d5f3-41d8-ad75-2137e55d4c2b

	measure 'Old Return Units' = CALCULATE([Units In Transit], PendingReceipt[Status] = "Old return never cleared (no warehouse receipt)")
		lineageTag: b29b02f0-1a79-47b7-9e4a-ece06c8d2ef3

	measure 'Unexplained Stock Lines' = CALCULATE([Lines], PendingReceipt[Status] = "Old stock in transit - no open issue or return in ERP")
		lineageTag: 9482437a-d379-4270-999e-80a2a612541c

	measure 'Unexplained Stock Units' = CALCULATE([Units In Transit], PendingReceipt[Status] = "Old stock in transit - no open issue or return in ERP")
		lineageTag: a88b4263-4190-47b8-8edf-d17917ffbdda

