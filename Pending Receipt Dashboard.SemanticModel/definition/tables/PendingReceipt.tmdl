	column 'Age Days' = IF(ISBLANK(PendingReceipt[Issue Posting Date]), BLANK(), DATEDIFF(PendingReceipt[Issue Posting Date], TODAY(), DAY))
		dataType: int64
		formatString: 0
		lineageTag: 4abc7662-df4f-4a87-a4d9-28cbcb86963d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Age Bucket Sort' = IF(ISBLANK(PendingReceipt[Age Days]), 6, IF(PendingReceipt[Age Days] <= 7, 1, IF(PendingReceipt[Age Days] <= 14, 2, IF(PendingReceipt[Age Days] <= 30, 3, IF(PendingReceipt[Age Days] <= 60, 4, 5)))))
		dataType: int64
		formatString: 0
		lineageTag: ea38b7e7-478d-4c1b-91a5-77cd6fa2ce9c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Age Bucket' = SWITCH(PendingReceipt[Age Bucket Sort], 1, "0-7 days", 2, "8-14 days", 3, "15-30 days", 4, "31-60 days", 5, "60+ days", "No issue date in last 24 months")
		dataType: string
		lineageTag: 10ad6c9b-0941-4a55-9171-186aafae2204
		summarizeBy: none
		sortByColumn: 'Age Bucket Sort'

		annotation SummarizationSetBy = Automatic

	column 'Owner Record Idx' =
			VAR buKey = UPPER(TRIM(PendingReceipt[BU]))
			VAR regionRaw = UPPER(TRIM(PendingReceipt[Region ID]))
			VAR terrRaw = UPPER(TRIM(PendingReceipt[Territory ID]))
			VAR shipTo = UPPER(TRIM(PendingReceipt[Ship To No]))
			VAR soldTo = UPPER(TRIM(PendingReceipt[Sold To No]))
			VAR regionKey = IF(buKey <> "" && regionRaw <> "", buKey & "|" & regionRaw)
			VAR shipKey = IF(buKey <> "" && shipTo <> "", buKey & "|" & shipTo)
			VAR soldKey = IF(buKey <> "" && soldTo <> "", buKey & "|" & soldTo)
			VAR byRegion = IF(ISBLANK(regionKey), BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[region_lookup_key], regionKey))
			VAR byTerr = IF(terrRaw = "", BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[territory_lookup_key], terrRaw))
			VAR byShip = IF(ISBLANK(shipKey), BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[acct_lookup_key], shipKey))
			VAR bySold = IF(ISBLANK(soldKey), BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[acct_lookup_key], soldKey))
			RETURN IF(buKey = "", BLANK(), COALESCE(byRegion, byTerr, byShip, bySold))
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 71383eca-42d8-45b1-bd68-983ad48acba0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Owner Basis' =
			VAR buKey = UPPER(TRIM(PendingReceipt[BU]))
			VAR regionRaw = UPPER(TRIM(PendingReceipt[Region ID]))
			VAR terrRaw = UPPER(TRIM(PendingReceipt[Territory ID]))
			VAR shipTo = UPPER(TRIM(PendingReceipt[Ship To No]))
			VAR soldTo = UPPER(TRIM(PendingReceipt[Sold To No]))
			VAR regionKey = IF(buKey <> "" && regionRaw <> "", buKey & "|" & regionRaw)
			VAR shipKey = IF(buKey <> "" && shipTo <> "", buKey & "|" & shipTo)
			VAR soldKey = IF(buKey <> "" && soldTo <> "", buKey & "|" & soldTo)
			VAR byRegion = IF(ISBLANK(regionKey), BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[region_lookup_key], regionKey))
			VAR byTerr = IF(terrRaw = "", BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[territory_lookup_key], terrRaw))
			VAR byShip = IF(ISBLANK(shipKey), BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[acct_lookup_key], shipKey))
			VAR bySold = IF(ISBLANK(soldKey), BLANK(), LOOKUPVALUE(OwnerAlignment[src_idx], OwnerAlignment[acct_lookup_key], soldKey))
			RETURN
			    IF(buKey = "", "default_no_bu",
			    IF(NOT ISBLANK(byRegion), "region",
			    IF(NOT ISBLANK(byTerr), "territory",
			    IF(NOT ISBLANK(byShip), "account_ship_to",
			    IF(NOT ISBLANK(bySold), "account_sold_to", "default_no_match")))))
		dataType: string
		lineageTag: ee573e6b-b40d-4667-ba85-65e1f78dd342
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Inventory Owner' =
			VAR idx = PendingReceipt[Owner Record Idx]
			VAR useRep = LEFT(UPPER(TRIM(PendingReceipt[Ship To No])), 5) = "80000"
			VAR rep = IF(ISBLANK(idx), BLANK(), LOOKUPVALUE(OwnerAlignment[owner_rep], OwnerAlignment[src_idx], idx))
			VAR consign = IF(ISBLANK(idx), BLANK(), LOOKUPVALUE(OwnerAlignment[owner_consign], OwnerAlignment[src_idx], idx))
			VAR picked = UPPER(TRIM(IF(useRep, rep, consign)))
			VAR o = IF(picked = "", "DEFAULT OWNER", picked)
			VAR n = SWITCH(TRUE(), RIGHT(o, 5) = "_OPEN", 5, RIGHT(o, 7) = "_CLOSED", 7, RIGHT(o, 5) = "_TEMP", 5, 0)
			RETURN TRIM(LEFT(o, LEN(o) - n))
		dataType: string
		lineageTag: f499aa81-9481-42ab-918d-502f0976b58b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Action Group' = SWITCH(PendingReceipt[Status Sort], 1, "1 Post the receipt", 2, "2 Check, then post the receipt (return in same batch)", 3, "3 Return in transit - no PR needed", 4, "4 Verify the posting", 5, "5 Overdue - check in ERP, then post the receipt", 6, "6 Old return in transit - no PR to post", 7, "7 Old stock in transit - review the stock record", "UNMAPPED STATUS")
		dataType: string
		lineageTag: 25588cf3-49ad-46a4-ada3-8e789d711226
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Next Step' =
			VAR rd = COALESCE(PendingReceipt[Receipt Doc], "n/a")
			VAR qIss = FORMAT(COALESCE(PendingReceipt[Qty Issued], 0), "#,0")
			VAR outQ = FORMAT(COALESCE(PendingReceipt[Outstanding Qty], 0), "#,0")
			VAR inT = FORMAT(PendingReceipt[Qty In Transit], "#,0")
			VAR d = FORMAT(PendingReceipt[Issue Posting Date], "d mmm yyyy")
			VAR retU = FORMAT(COALESCE(PendingReceipt[Key Return Units], 0), "#,0")
			RETURN
			    SWITCH(PendingReceipt[Status Sort],
			        1, "Issue posted " & d & " (receipt doc " & rd & "); " & outQ & " of " & qIss & " still waiting for the receipt. Confirm the unit arrived, then post the receipt in ERP.",
			        2, "Issue posted " & d & " (receipt doc " & rd & "), but this batch also has " & retU & " unit(s) of a return in transit (no warehouse receipt yet), so this serial may be the return. Check the unit, then post the receipt only if it is the delivery.",
			        3, "A return is in transit for this batch and no warehouse receipt is posted yet. This is not a pending PR; the warehouse receipt is what is missing.",
			        4, "The receipt is already posted for the full issue quantity, but Field Inventory still shows " & inT & " in transit. Check the receipt went to the right batch and quantity, then correct the stock record.",
			        5, "The issue for this batch is older than 24 months and ERP shows more issue than receipt, so the receipt was most likely never posted. Find the issue in ERP, confirm the unit arrived, then post the receipt.",
				        6, "ERP shows more returns than warehouse receipts for this batch at " & PendingReceipt[Plant] & ", so an old return was never closed. This is not a receipt to post. Ask the warehouse to close the return or correct the stock record.",
				        7, "ERP shows no open issue and no open return for this batch at " & PendingReceipt[Plant] & " in its full history, so nothing explains why the unit is still in transit. Review the stock record.",
				        "UNMAPPED STATUS - check the Status Sort mapping")
		dataType: string
		lineageTag: 082dd4db-a0fb-4fd3-9c59-c9c1befea170
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

